<h1><%= @transaction_detail.new_record? ? 'New Transaction' : 'Edit Transaction' %></h1>

<%= form_with model: @transaction_detail, local: true do |form| %>
  <div>
    <%= form.label :transaction_type %>
    <%= form.select :transaction_type, ['Buy', 'Sell'], prompt: 'Select Transaction Type' %>
  </div>

  <div>
    <%= form.label :user_detail_id %>
    <%= form.collection_select :user_detail_id, UserDetail.all, :id, :name, prompt: 'Select User' %>
  </div>

  <div>
    <%= form.label :stock_id %>
    <%= form.collection_select :stock_id, Stock.all, :id, :stock_name, prompt: 'Select Stock' %>
  </div>

  <div>
    <%= form.label :quantity %>
    <%= form.number_field :quantity %>
  </div>

  <div>
    <%= form.label :transaction_value %>
    <%= form.number_field :transaction_value, step: 0.01 %>
  </div>

  <%= form.submit 'Save', class: 'btn btn-success' %>
<% end %>

<%= link_to 'Back to Transactions', transaction_details_path, class: 'btn btn-primary' %>
