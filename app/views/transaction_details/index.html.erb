<h1>All Transactions</h1>

<table>
  <thead>
    <tr>
      <th>Transaction Type</th>
      <th>User</th>
      <th>Stock</th>
      <th>Quantity</th>
      <th>Transaction Value</th>
      <th>Date</th>
    </tr>
  </thead>
  <tbody>
    <% @transaction_details.each do |transaction| %>
      <tr>
        <td><%= transaction.transaction_type %></td>
        <td><%= transaction.user_detail.name %></td>
        <td><%= transaction.stock.stock_name %></td>
        <td><%= transaction.quantity %></td>
        <td><%= number_to_currency(transaction.transaction_value) %></td>
        <td><%= transaction.created_at.strftime('%d %b %Y') %></td>
      </tr>
    <% end %>
  </tbody>
</table>
