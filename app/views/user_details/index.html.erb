<h1>User Details</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Mobile</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @user_details.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.mobile_number %></td>
        <td>
          <%= link_to 'View', user_detail_path(user), class: 'btn btn-info' %>
          <%= link_to 'Edit', edit_user_detail_path(user), class: 'btn btn-warning' %>
          <%= link_to 'Delete', user_detail_path(user), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Add New User', new_user_detail_path, class: 'btn btn-success' %>
