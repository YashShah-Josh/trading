<h1>All Stocks</h1>

<table>
  <thead>
    <tr>
      <th>Stock Name</th>
      <th>Price</th>
      <th>Quantity Available</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @stocks.each do |stock| %>
      <tr>
        <td><%= stock.stock_name %></td>
        <td><%= number_to_currency(stock.stock_price) %></td>
        <td><%= stock.quantity_available %></td>
        <td>
          <%= link_to 'View', stock_path(stock), class: 'btn btn-info' %>
          <%= link_to 'Edit', edit_stock_path(stock), class: 'btn btn-warning' %>
          <%= link_to 'Delete', stock_path(stock), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Add New Stock', new_stock_path, class: 'btn btn-success' %>
