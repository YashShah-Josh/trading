<h1><%= @stock.stock_name %></h1>

<p><strong>Price:</strong> <%= number_to_currency(@stock.stock_price) %></p>
<p><strong>Quantity Available:</strong> <%= @stock.quantity_available %></p>

<h2>Transactions for This Stock</h2>
<% if @stock.transaction_details.any? %>
  <table>
    <thead>
      <tr>
        <th>User</th>
        <th>Transaction Type</th>
        <th>Quantity</th>
        <th>Transaction Value</th>
        <th>Date</th>
      </tr>
    </thead>
    <tbody>
      <% @stock.transaction_details.each do |transaction| %>
        <tr>
          <td><%= transaction.user_detail.name %></td>
          <td><%= transaction.transaction_type %></td>
          <td><%= transaction.quantity %></td>
          <td><%= number_to_currency(transaction.transaction_value) %></td>
          <td><%= transaction.created_at.strftime('%d %b %Y') %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No transactions found for this stock.</p>
<% end %>

<%= link_to 'Back to Stocks', stocks_path, class: 'btn btn-primary' %>
